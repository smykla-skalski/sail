{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Permissions for the settings window",
  "windows": ["settings"],
  "permissions": [
    "allow-diagnostic-event",
    "allow-memory-agent-status",
    "allow-preview-memory-agent-install",
    "allow-preview-memory-agent-uninstall",
    "allow-install-memory-agent",
    "allow-install-memory-agents",
    "allow-uninstall-memory-agent",
    "allow-save-setting",
    "allow-inspect-agent-hooks",
    "allow-inspect-hook-integration",
    "allow-enable-hook-integration",
    "allow-remove-hook-integration",
    "allow-memory-project-key",
    "allow-memory-status",
    "allow-memory-list",
    "allow-memory-search",
    "allow-memory-remember",
    "allow-memory-inspect",
    "allow-memory-forget",
    "allow-memory-rate",
    "allow-memory-provider-status",
    "allow-verify-memory-provider",
    "allow-set-memory-provider",
    "allow-sync-memory-provider",
    "allow-resolve-memory-provider-pending",
    "allow-open-external-url",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit-to",
    "core:window:allow-close"
  ]
}
