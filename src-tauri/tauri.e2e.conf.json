{
  "productName": "Sail E2E",
  "identifier": "dev.smykla.sail.e2e",
  "build": {
    "beforeBuildCommand": "npm run build -- --mode e2e"
  },
  "bundle": {
    "macOS": {
      "entitlements": "./Entitlements.e2e.plist"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "capabilities": [
        "default",
        "settings",
        "browser",
        {
          "identifier": "e2e",
          "webviews": ["main", "settings"],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default",
            "core:window:allow-set-theme",
            "core:window:allow-is-visible",
            "core:path:allow-resolve-directory",
            "allow-acp-reset-test-runtimes",
            "allow-acp-set-idle-close-timeout",
            "allow-reset-test-settings",
            "allow-send-test-tab"
          ]
        }
      ]
    }
  }
}
