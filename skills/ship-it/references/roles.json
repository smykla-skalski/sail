{
  "schema_version": "sai.ship-it.roles/v1",
  "roles": [
    { "id": "exploration", "phase": "explore", "dispatch": "current-execution" },
    { "id": "implementation", "phase": "implement", "dispatch": "current-execution" },
    { "id": "review", "phase": "review", "dispatch": "routed-worker" },
    { "id": "testing", "phase": "test", "dispatch": "routed-worker" },
    { "id": "ci-triage", "phase": "pr", "dispatch": "routed-worker" }
  ],
  "route_record": {
    "required_fields": [
      "role",
      "requested",
      "actual",
      "sourceRevision",
      "mechanism",
      "executionId",
      "modelResolution",
      "contextIsolationRequired",
      "timestamp"
    ],
    "selector_fields": ["provider", "model", "variant"],
    "mechanisms": ["native-subagent", "generic-subagent", "skill", "inline", "service", "process"],
    "model_resolutions": ["resolved", "unresolved"]
  },
  "route_diagnostic": {
    "required_fields": ["role", "requested", "stage", "reason", "timestamp"],
    "optional_fields": ["actual", "executionId", "modelResolution"],
    "stages": ["pre-dispatch", "post-dispatch"],
    "reasons": [
      "unsupported-selector",
      "unavailable-mechanism",
      "metadata-unavailable",
      "context-reuse",
      "inline-execution"
    ]
  },
  "adapters": {
    "claude-code": {
      "subagents": ["native-subagent", "generic-subagent"],
      "fallback": null,
      "selectors": {
        "provider": "session-provider",
        "model": "agent-model",
        "variant": "unsupported"
      },
      "unsupported_selector": "reject-before-dispatch"
    },
    "codex": {
      "subagents": ["generic-subagent"],
      "fallback": null,
      "selectors": {
        "provider": "session-provider",
        "model": "spawn-agent-model",
        "variant": "spawn-agent-reasoning-effort"
      },
      "unsupported_selector": "reject-before-dispatch"
    },
    "opencode": {
      "subagents": ["generic-subagent"],
      "fallback": null,
      "selectors": {
        "provider": "task-model-provider",
        "model": "task-model-id",
        "variant": "task-model-variant"
      },
      "unsupported_selector": "reject-before-dispatch"
    },
    "copilot-cli": {
      "subagents": ["native-subagent", "generic-subagent"],
      "fallback": null,
      "selectors": {
        "provider": "session-provider",
        "model": "agent-model",
        "variant": "unsupported"
      },
      "unsupported_selector": "reject-before-dispatch"
    },
    "sail": {
      "subagents": ["native-subagent"],
      "fallback": null,
      "selectors": {
        "provider": "worker-provider",
        "model": "worker-model",
        "variant": "worker-variant"
      },
      "unsupported_selector": "reject-before-dispatch"
    }
  }
}
