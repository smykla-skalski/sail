{
  "name": "sail",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint --deny-warnings . && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test test/*.test.ts",
    "test:agent-replay": "node scripts/replay-agent-failures.mjs",
    "test:contract": "node test/live-contract.mjs",
    "build": "npm run check && vite build",
    "build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "wdio run wdio.conf.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@opencode/client": "2.0.24",
    "@smykla-skalski/sui": "^0.2.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.0.0",
    "mermaid": "^12.0.0",
    "svelte": "^5.57.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.1",
    "@wdio/cli": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1"
  },
  "overrides": {
    "@puppeteer/browsers": "^3.2.3",
    "deepmerge-ts": "^8.0.2",
    "diff": "^9.0.0",
    "encoding-sniffer": "^1.0.2",
    "glob": "^13.0.6",
    "mocha": "^11.8.0",
    "serialize-javascript": "^7.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "edgedriver": false,
    "geckodriver": false,
    "fsevents": false,
    "msgpackr-extract": false
  }
}
